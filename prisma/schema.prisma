generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 Int                 @id @default(autoincrement())
  firstName          String
  lastName           String
  fullName           String?
  username           String?             @unique
  nationalCode       String?             @unique
  email              String              @unique
  phone              String?             @unique
  password           String
  gender             String?
  birthDate          DateTime?
  province           String?
  city               String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  lifeStage          String?             @default("user")
  avatarUrl          String?
  childAdmins        ChildAdmin[]
  invitations        ChildInvitation[]
  inspirationActions InspirationAction[]
  medicalRecords     MedicalRecord[]
  reminders          Reminder[]
  savedArticles      SavedArticle[]
  addresses          UserAddress[]
  womenCycle         WomenCycle?
  womenHealthReports WomenHealthReport[]
  conversations1     Conversation[]      @relation("User1Conversations")
  conversations2     Conversation[]      @relation("User2Conversations")
  messages           Message[]
  lastSocialSeenAt   DateTime?
}

model Child {
  id          Int               @id @default(autoincrement())
  fullName    String?
  gender      String?
  birthDate   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  admins      ChildAdmin[]
  invitations ChildInvitation[]
  growth      GrowthMetric[]
  testResults TestResult[]
}

model GrowthMetric {
  id                Int      @id @default(autoincrement())
  childId           Int
  height            Float?
  weight            Float?
  headCircumference Float?
  measuredAt        DateTime @default(now())
  child             Child    @relation(fields: [childId], references: [id])
}

model Test {
  id          Int          @id @default(autoincrement())
  title       String
  description String?
  category    String?
  createdAt   DateTime     @default(now())
  results     TestResult[]
}

model TestResult {
  id          Int      @id @default(autoincrement())
  testId      Int
  childId     Int
  resultValue String?
  score       Int?
  createdAt   DateTime @default(now())
  child       Child    @relation(fields: [childId], references: [id])
  test        Test     @relation(fields: [testId], references: [id])
}

model Article {
  id        Int            @id @default(autoincrement())
  title     String
  slug      String         @unique
  category  String?
  image     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  savedBy   SavedArticle[]
}

model SavedArticle {
  id        Int      @id @default(autoincrement())
  userId    Int
  articleId Int
  savedAt   DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model ChildAdmin {
  id        Int      @id @default(autoincrement())
  childId   Int
  userId    Int
  role      String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  slot      Int      @default(0)
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([childId, userId])
  @@unique([childId, role, slot])
}

model ChildInvitation {
  id           Int       @id @default(autoincrement())
  childId      Int
  inviterId    Int?
  email        String?
  phone        String?
  token        String    @unique
  expiresAt    DateTime
  accepted     Boolean   @default(false)
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())
  relationType String    @default("relative")
  roleLabel    String?
  slot         Int       @default(0)
  child        Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  inviter      User?     @relation(fields: [inviterId], references: [id])

  @@index([childId])
  @@index([inviterId])
  @@index([email])
  @@index([phone])
  @@index([relationType])
}

model UserAddress {
  id         Int      @id @default(autoincrement())
  userId     Int
  label      String
  address    String
  postalCode String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, label])
  @@index([userId])
}

model InspirationItem {
  id                 Int      @id @default(autoincrement())
  mode               String
  quote              String
  author             String?
  exerciseTitle      String
  exerciseText       String
  durationSec        Int      @default(180)
  reflectionQuestion String
  reflectionHint     String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([mode])
  @@index([isActive])
}

model InspirationAction {
  id        Int      @id @default(autoincrement())
  userId    Int
  dateKey   String
  mode      String
  completed Boolean  @default(false)
  saved     Boolean  @default(false)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey, mode])
  @@index([userId])
  @@index([dateKey])
  @@index([mode])
}

model Reminder {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String
  description String?
  type        String
  repeat      String
  remindAt    DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([remindAt])
  @@index([type])
}

model WomenCycle {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  lastPeriodAt DateTime
  cycleLength  Int      @default(28)
  periodLength Int      @default(5)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WomenHealthReport {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      String
  scores    Json
  answers   Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model MedicalRecord {
  id          Int                 @id @default(autoincrement())
  userId      Int
  title       String
  doctor      String?
  category    String
  recordDate  DateTime
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  attachments MedicalAttachment[]
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordDate])
  @@index([userId, category])
}

model MedicalAttachment {
  id        Int           @id @default(autoincrement())
  recordId  Int
  fileName  String
  mimeType  String
  fileSize  Int?
  url       String
  createdAt DateTime      @default(now())
  record    MedicalRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
}

model Conversation {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user1Id Int
  user2Id Int

  user1 User @relation("User1Conversations", fields: [user1Id], references: [id])
  user2 User @relation("User2Conversations", fields: [user2Id], references: [id])

  messages Message[]

  @@unique([user1Id, user2Id])
}

model Message {
  id             Int       @id @default(autoincrement())
  conversationId Int
  senderId       Int
  text           String?
  type           String // text | image | video
  fileUrl        String?
  status         String    @default("sent") // sent | read
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])
}
