generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 Int                 @id @default(autoincrement())
  firstName          String
  lastName           String
  fullName           String?
  username           String?             @unique
  nationalCode       String?             @unique
  email              String              @unique
  phone              String?             @unique
  password           String
  gender             String?
  birthDate          DateTime?
  province           String?
  city               String?
  avatarUrl          String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  lifeStage          String?             @default("user")
  childAdmins        ChildAdmin[]
  invitations        ChildInvitation[]
  savedArticles      SavedArticle[]
  addresses          UserAddress[]
  inspirationActions InspirationAction[]
  reminders          Reminder[]
  womenCycle         WomenCycle?
  womenHealthReports WomenHealthReport[]
  medicalRecords     MedicalRecord[]
}

model Child {
  id          Int               @id @default(autoincrement())
  fullName    String?
  gender      String?
  birthDate   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  admins      ChildAdmin[]
  invitations ChildInvitation[]
  growth      GrowthMetric[]
  testResults TestResult[]
}

model GrowthMetric {
  id                Int      @id @default(autoincrement())
  childId           Int
  height            Float?
  weight            Float?
  headCircumference Float?
  measuredAt        DateTime @default(now())
  child             Child    @relation(fields: [childId], references: [id])
}

model Test {
  id          Int          @id @default(autoincrement())
  title       String
  description String?
  category    String?
  createdAt   DateTime     @default(now())
  results     TestResult[]
}

model TestResult {
  id          Int      @id @default(autoincrement())
  testId      Int
  childId     Int
  resultValue String?
  score       Int?
  createdAt   DateTime @default(now())
  child       Child    @relation(fields: [childId], references: [id])
  test        Test     @relation(fields: [testId], references: [id])
}

model Article {
  id        Int            @id @default(autoincrement())
  title     String
  slug      String         @unique
  category  String?
  image     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  savedBy   SavedArticle[]
}

model SavedArticle {
  id        Int      @id @default(autoincrement())
  userId    Int
  articleId Int
  savedAt   DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model ChildAdmin {
  id        Int      @id @default(autoincrement())
  childId   Int
  userId    Int
  role      String
  slot      Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([childId, userId])
  @@unique([childId, role, slot])
}

model ChildInvitation {
  id           Int       @id @default(autoincrement())
  childId      Int
  inviterId    Int?
  email        String?
  phone        String?
  token        String    @unique
  expiresAt    DateTime
  accepted     Boolean   @default(false)
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())
  // ✅ NEW: نقش و جایگاه در درختواره
  relationType String    @default("relative") // e.g. "khale", "dayi", "aunt", "uncle", "friend", "relative"
  slot         Int       @default(0) // 0,1,2... برای خاله اول/دوم/سوم
  roleLabel    String? // e.g. "خاله" (اختیاری برای UI)
  child        Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  inviter      User?     @relation(fields: [inviterId], references: [id])

  @@index([childId])
  @@index([inviterId])
  @@index([email])
  @@index([phone])
  @@index([relationType])
}

model UserAddress {
  id         Int      @id @default(autoincrement())
  userId     Int
  label      String // مثل: خانه، شرکت
  address    String // متن آدرس
  postalCode String? // کد پستی (اختیاری)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, label])
  @@index([userId])
}

model InspirationItem {
  id                 Int      @id @default(autoincrement())
  mode               String // calm, focus, energy, relation, discipline
  quote              String
  author             String?
  exerciseTitle      String
  exerciseText       String
  durationSec        Int      @default(180)
  reflectionQuestion String
  reflectionHint     String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([mode])
  @@index([isActive])
}

model InspirationAction {
  id        Int      @id @default(autoincrement())
  userId    Int
  dateKey   String // YYYY-MM-DD
  mode      String
  completed Boolean  @default(false)
  saved     Boolean  @default(false)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey, mode])
  @@index([userId])
  @@index([dateKey])
  @@index([mode])
}

model Reminder {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String
  description String?
  type        String // birthday | anniversary | other
  repeat      String // yearly | once
  remindAt    DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([remindAt])
  @@index([type])
}

model WomenCycle {
  id     Int @id @default(autoincrement())
  userId Int @unique

  // تاریخ شروع آخرین قاعدگی (به میلادی در DB)
  lastPeriodAt DateTime

  // طول چرخه و طول پریود
  cycleLength  Int @default(28)
  periodLength Int @default(5)

  // برای گزارش/دیباگ: آخرین آپدیت از طرف کاربر
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WomenHealthReport {
  id Int @id @default(autoincrement())

  // گزارش مربوط به کدام کاربر است؟
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // تاریخ ثبت (همونی که از فرانت میاد: مثلا "1404/08/02")
  date String

  // امتیازها (skin/breast/vagina/uterus) به صورت JSON
  scores Json

  // جواب‌های خام تست (برای گزارش کامل‌تر در آینده)
  answers Json?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model MedicalRecord {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String
  doctor      String?
  category    String
  recordDate  DateTime // تاریخ گزارش (گرگوریان)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments MedicalAttachment[]

  @@index([userId, recordDate])
  @@index([userId, category])
}

model MedicalAttachment {
  id        Int      @id @default(autoincrement())
  recordId  Int
  fileName  String
  mimeType  String
  fileSize  Int?
  url       String // لینک فایل (S3/Arvan)
  createdAt DateTime @default(now())

  record MedicalRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
}
