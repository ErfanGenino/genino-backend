generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                       Int                       @id @default(autoincrement())
  firstName                String
  lastName                 String
  fullName                 String?
  username                 String?                   @unique
  nationalCode             String?                   @unique
  email                    String                    @unique
  phone                    String?                   @unique
  password                 String
  gender                   String?
  birthDate                DateTime?
  province                 String?
  city                     String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  lifeStage                String?                   @default("user")
  avatarUrl                String?
  lastSocialSeenAt         DateTime?
  childAdmins              ChildAdmin[]
  invitations              ChildInvitation[]
  receivedChildInvitations ChildInvitation[]         @relation("ChildInvitationTarget")
  notifications            Notification[]
  inspirationActions       InspirationAction[]
  medicalRecords           MedicalRecord[]
  reminders                Reminder[]
  savedArticles            SavedArticle[]
  addresses                UserAddress[]
  womenCycle               WomenCycle?
  womenHealthReports       WomenHealthReport[]
  menHealthReports         MenHealthReport[]
  calorieTracker           CalorieTracker?
  calorieProfiles          CalorieProfile[]
  calorieDailyLogs         CalorieDailyLog[]
  conversationsAsUser1     Conversation[]            @relation("ConversationUser1")
  conversationsAsUser2     Conversation[]            @relation("ConversationUser2")
  sentMessages             Message[]                 @relation("MessageSender")
  messageReactions         MessageReaction[]
  sentChatRoomMessages     ChatRoomMessage[]         @relation("ChatRoomMessageSender")
  chatRoomReactions        ChatRoomMessageReaction[]
  chatRoomPresences        ChatRoomPresence[]
  createdChatRooms         ChatRoom[]
  favoriteChatRooms        FavoriteChatRoom[]
  chatRoomMutes            ChatRoomMute[]            @relation("MutedUser")
  issuedChatRoomMutes      ChatRoomMute[]            @relation("MutedByUser")
  memoryAlbums             MemoryAlbum[]
  memoryAlbumLikes         MemoryAlbumLike[]
  memoryAlbumComments      MemoryAlbumComment[]
  childFollowRequests      ChildFollowRequest[]
  childAchievements        ChildAchievement[]
}

model Child {
  id                Int                  @id @default(autoincrement())
  fullName          String?
  gender            String?
  birthDate         DateTime?
  photo             String?
  interests         String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  admins            ChildAdmin[]
  invitations       ChildInvitation[]
  growth            GrowthMetric[]
  testResults       TestResult[]
  memoryAlbums      MemoryAlbum[]
  followRequests    ChildFollowRequest[]
  childAchievements ChildAchievement[]
}

model GrowthMetric {
  id                Int      @id @default(autoincrement())
  childId           Int
  height            Float?
  weight            Float?
  headCircumference Float?
  measuredAt        DateTime @default(now())
  child             Child    @relation(fields: [childId], references: [id])
}

model Test {
  id          Int          @id @default(autoincrement())
  title       String
  description String?
  category    String?
  createdAt   DateTime     @default(now())
  results     TestResult[]
}

model TestResult {
  id          Int      @id @default(autoincrement())
  testId      Int
  childId     Int
  resultValue String?
  score       Int?
  createdAt   DateTime @default(now())
  child       Child    @relation(fields: [childId], references: [id])
  test        Test     @relation(fields: [testId], references: [id])
}

model Article {
  id        Int            @id @default(autoincrement())
  title     String
  slug      String         @unique
  category  String?
  image     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  savedBy   SavedArticle[]
}

model SavedArticle {
  id        Int      @id @default(autoincrement())
  userId    Int
  articleId Int
  savedAt   DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model ChildAdmin {
  id            Int       @id @default(autoincrement())
  childId       Int
  userId        Int
  role          String
  requestedRole String?
  status        String    @default("CONNECTED")
  isPrimary     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  approvedAt    DateTime?
  rejectedAt    DateTime?
  approvedById  Int?
  slot          Int       @default(0)

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([childId, userId])
  @@unique([childId, role, slot])
}

model ChildInvitation {
  id           Int       @id @default(autoincrement())
  childId      Int
  inviterId    Int?
  email        String?
  phone        String?
  token        String    @unique
  expiresAt    DateTime
  accepted     Boolean   @default(false)
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())
  relationType String    @default("relative")
  roleLabel    String?
  slot         Int       @default(0)
  targetUserId Int?

  child      Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  inviter    User? @relation(fields: [inviterId], references: [id])
  targetUser User? @relation("ChildInvitationTarget", fields: [targetUserId], references: [id])

  @@index([childId])
  @@index([inviterId])
  @@index([email])
  @@index([phone])
  @@index([relationType])
  @@index([targetUserId])
}

model ChildFollowRequest {
  id            Int      @id @default(autoincrement())
  childId       Int
  requesterId   Int
  requestedRole String
  approvedRole  String?
  status        String   @default("PENDING_PARENT")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  child     Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  requester User  @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@unique([childId, requesterId, requestedRole])
  @@index([childId])
  @@index([requesterId])
  @@index([status])
}

model ChildAchievement {
  id Int @id @default(autoincrement())

  childId      Int
  issuerUserId Int

  category    String
  title       String
  description String?

  issuerRole String?

  issuedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  child      Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  issuerUser User  @relation(fields: [issuerUserId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([issuerUserId])
  @@index([category])
  @@index([issuedAt])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  title     String
  body      String?
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
  @@index([type])
}

model UserAddress {
  id         Int      @id @default(autoincrement())
  userId     Int
  label      String
  address    String
  postalCode String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, label])
  @@index([userId])
}

model InspirationItem {
  id                 Int      @id @default(autoincrement())
  mode               String
  quote              String
  author             String?
  exerciseTitle      String
  exerciseText       String
  durationSec        Int      @default(180)
  reflectionQuestion String
  reflectionHint     String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([mode])
  @@index([isActive])
}

model InspirationAction {
  id        Int      @id @default(autoincrement())
  userId    Int
  dateKey   String
  mode      String
  completed Boolean  @default(false)
  saved     Boolean  @default(false)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey, mode])
  @@index([userId])
  @@index([dateKey])
  @@index([mode])
}

model Reminder {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String
  description String?
  type        String
  repeat      String
  remindAt    DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([remindAt])
  @@index([type])
}

model WomenCycle {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  lastPeriodAt DateTime
  cycleLength  Int      @default(28)
  periodLength Int      @default(5)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WomenHealthReport {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      String
  scores    Json
  answers   Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model MenHealthReport {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      String
  type      String
  score     String?
  status    String?
  tip       String?
  answers   Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model MedicalRecord {
  id          Int                 @id @default(autoincrement())
  userId      Int
  title       String
  doctor      String?
  category    String
  recordDate  DateTime
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  attachments MedicalAttachment[]
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordDate])
  @@index([userId, category])
}

model MedicalAttachment {
  id        Int           @id @default(autoincrement())
  recordId  Int
  fileName  String
  mimeType  String
  fileSize  Int?
  url       String
  createdAt DateTime      @default(now())
  record    MedicalRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
}

model Conversation {
  id        Int      @id @default(autoincrement())
  user1Id   Int
  user2Id   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user1    User      @relation("ConversationUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2    User      @relation("ConversationUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([user1Id])
  @@index([user2Id])
  @@index([updatedAt])
}

model Message {
  id             Int       @id @default(autoincrement())
  conversationId Int
  senderId       Int
  text           String?
  type           String    @default("text")
  fileUrl        String?
  duration       Int?
  status         String    @default("sent")
  readAt         DateTime?

  replyToMessageId       Int?
  forwardedFromMessageId Int?

  deletedForEveryoneAt DateTime?
  deletedBySenderAt    DateTime?
  deletedByReceiverAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  replyToMessage Message?  @relation("MessageReply", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies        Message[] @relation("MessageReply")

  forwardedFromMessage Message?  @relation("MessageForward", fields: [forwardedFromMessageId], references: [id], onDelete: SetNull)
  forwardedCopies      Message[] @relation("MessageForward")

  reactions MessageReaction[]

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@index([readAt])
  @@index([replyToMessageId])
  @@index([forwardedFromMessageId])
}

model MessageReaction {
  id        Int      @id @default(autoincrement())
  messageId Int
  userId    Int
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

model ChatRoom {
  id          Int                @id @default(autoincrement())
  title       String
  description String?
  imageUrl    String?
  creatorId   Int?
  creator     User?              @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  favoritedBy FavoriteChatRoom[]
  mutes       ChatRoomMute[]

  messages  ChatRoomMessage[]
  presences ChatRoomPresence[]

  @@index([isActive])
  @@index([updatedAt])
  @@index([creatorId])
}

model ChatRoomMessage {
  id       Int     @id @default(autoincrement())
  roomId   Int
  senderId Int
  text     String?
  type     String  @default("text")
  fileUrl  String?
  duration Int?

  replyToMessageId       Int?
  forwardedFromMessageId Int?

  deletedForEveryoneAt DateTime?
  deletedBySenderAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender User     @relation("ChatRoomMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  replyToMessage ChatRoomMessage?  @relation("ChatRoomMessageReply", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies        ChatRoomMessage[] @relation("ChatRoomMessageReply")

  forwardedFromMessage ChatRoomMessage?  @relation("ChatRoomMessageForward", fields: [forwardedFromMessageId], references: [id], onDelete: SetNull)
  forwardedCopies      ChatRoomMessage[] @relation("ChatRoomMessageForward")

  reactions ChatRoomMessageReaction[]

  @@index([roomId])
  @@index([senderId])
  @@index([createdAt])
  @@index([replyToMessageId])
  @@index([forwardedFromMessageId])
}

model ChatRoomMessageReaction {
  id        Int      @id @default(autoincrement())
  messageId Int
  userId    Int
  emoji     String
  createdAt DateTime @default(now())

  message ChatRoomMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

model ChatRoomPresence {
  id         Int      @id @default(autoincrement())
  roomId     Int
  userId     Int
  joinedAt   DateTime @default(now())
  lastSeenAt DateTime @default(now())

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
  @@index([lastSeenAt])
}

model FavoriteChatRoom {
  id        Int      @id @default(autoincrement())
  userId    Int
  roomId    Int
  createdAt DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
  @@index([userId])
  @@index([roomId])
  @@index([createdAt])
}

model ChatRoomMute {
  id        Int      @id @default(autoincrement())
  roomId    Int
  userId    Int
  mutedById Int
  createdAt DateTime @default(now())

  room    ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user    User     @relation("MutedUser", fields: [userId], references: [id], onDelete: Cascade)
  mutedBy User     @relation("MutedByUser", fields: [mutedById], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
  @@index([mutedById])
  @@index([createdAt])
}

model CalorieTracker {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  startDate String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CalorieProfile {
  id                  Int      @id @default(autoincrement())
  userId              Int
  effectiveFrom       String
  calories            Float
  gender              String?
  age                 Int?
  height              Float?
  weight              Float?
  activityLevel       Float?
  bmi                 Float?
  idealWeightMin      Float?
  idealWeightMax      Float?
  goal                String?
  maintenanceCalories Float?
  createdAt           DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, effectiveFrom])
}

model CalorieDailyLog {
  id              Int      @id @default(autoincrement())
  userId          Int
  dateKey         String
  dateText        String
  foods           Json
  calories        Json
  totalCalories   Float    @default(0)
  allowedCalories Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey])
  @@index([userId])
  @@index([userId, dateKey])
}

model MemoryAlbum {
  id          Int      @id @default(autoincrement())
  userId      Int
  childId     Int
  title       String
  description String?
  coverUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  child    Child                @relation(fields: [childId], references: [id], onDelete: Cascade)
  photos   MemoryAlbumPhoto[]
  likes    MemoryAlbumLike[]
  comments MemoryAlbumComment[]

  @@index([userId])
  @@index([childId])
  @@index([userId, childId])
  @@index([createdAt])
}

model MemoryAlbumPhoto {
  id        Int      @id @default(autoincrement())
  albumId   Int
  url       String
  fileName  String?
  mimeType  String?
  fileSize  Int?
  caption   String?
  createdAt DateTime @default(now())

  album MemoryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId])
  @@index([createdAt])
}

model MemoryAlbumLike {
  id        Int      @id @default(autoincrement())
  albumId   Int
  userId    Int
  createdAt DateTime @default(now())

  album MemoryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([albumId, userId])
  @@index([albumId])
  @@index([userId])
}

model MemoryAlbumComment {
  id        Int      @id @default(autoincrement())
  albumId   Int
  userId    Int
  text      String
  createdAt DateTime @default(now())

  album MemoryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([albumId])
  @@index([userId])
  @@index([createdAt])
}
